NODE_ENV=development
PORT=3000
SWAGGER_ENABLED=false

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
REDIS_URL=redis://localhost:6379

YTDLP_PATH=/usr/bin/yt-dlp
YTDLP_TIMEOUT_MS=10000
YTDLP_MAX_CONCURRENT=3

YTDLP_STREAM_URL_PROBE=0

STREAM_DIRECT_HOSTS=

YTDLP_COOKIES_PATH=

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

LASTFM_API_KEY=
RESEND_API_KEY=re_replace_with_real_key
RESEND_TEST_ENDPOINT_ENABLED=false

# Spotify import (optional). Create an app at developer.spotify.com and add
# SPOTIFY_REDIRECT_URI to its Redirect URIs. Leave empty to hide the feature.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=https://api.example.com/api/spotify/callback
SPOTIFY_APP_REDIRECT_URI=exos://spotify-auth
