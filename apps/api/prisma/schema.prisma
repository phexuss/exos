generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String             @id @default(uuid())
  name           String
  email          String             @unique
  username       String             @unique
  passwordHash   String
  isVerified     Boolean            @default(false)
  verifyToken    String?            @unique
  verifyTokenExp DateTime?
  /// Wrong guesses against the current verifyToken; reset with each new code.
  verifyAttempts Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  userLibraries  UserLibrary[]
  recentlyPlayed UserRecentlyPlayed[]
  playlists      UserPlaylist[]
  sessions       Session[]
  codes          VerificationCode[]
  spotify        SpotifyConnection?
}

model VerificationCode {
  id        String   @id @default(uuid())
  code      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  /// Guesses made against this code; it stops working at the limit.
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
}

model UserLibrary {
  id          String   @id @default(uuid())
  userId      String
  trackId     String?
  deezerId    String?
  scUrl       String?
  source      String
  title       String
  artistName  String
  artistId    String?
  album       String?
  coverUrl    String?
  duration    String
  durationSec Int      @default(0)
  previewUrl  String?
  isrc        String?
  addedAt     DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deezerId])
  @@unique([userId, scUrl])
  @@index([userId, addedAt])
}

model UserRecentlyPlayed {
  id          String   @id @default(uuid())
  userId      String
  trackId     String?
  deezerId    String?
  scUrl       String?
  source      String
  title       String
  artistName  String
  artistId    String?
  album       String?
  coverUrl    String?
  duration    String
  durationSec Int      @default(0)
  previewUrl  String?
  isrc        String?
  playedAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deezerId])
  @@unique([userId, scUrl])
  @@index([userId, playedAt])
}

/// A phone's local playlist, backed up so a reinstall or a new phone can
/// rebuild it. `tracks` is the ordered list of LibraryTrackDto snapshots.
model UserPlaylist {
  id        String   @id @default(uuid())
  userId    String
  /// The playlist id on the device that created it (pl-<timestamp>).
  clientId  String
  name      String
  coverUrl  String?
  tracks    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([userId, updatedAt])
}

model Session {
  id               String   @id @default(uuid())
  userId           String
  refreshTokenHash String   @unique
  device           String?
  expiresAt        DateTime
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SpotifyConnection {
  userId        String   @id
  spotifyUserId String
  displayName   String?
  /// AES-256-GCM encrypted refresh token (iv.tag.ciphertext, base64url).
  refreshToken  String
  scope         String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
